<html>

<head>
    <meta charset="UTF-8" />
    <title>Open-Source Licenses</title>
    <style>
        body {
            background: #333;
            color: white;
        }
        a {
            color: skyblue;
        }
        .container {
            font-family: sans-serif;
            max-width: 800px;
            margin: 0 auto;
        }
        .intro {
            text-align: center;
        }
        .licenses-list {
            list-style-type: none;
            margin: 0;
            padding: 0;
        }
        .license-used-by {
            margin-top: -10px;
        }
        .license-text {
            max-height: 200px;
            overflow-y: scroll;
            white-space: pre-wrap;
        }
        .back {
            padding: 6px 0;
            display: inline-block;
        }
        /* Cha's own notice: ordinary flowing text, left-aligned inside the
           centered intro. The source keeps the MIT text's original line breaks
           so a diff shows only the tags changing, but HTML collapses them, so
           it wraps to the window like any paragraph. */
        .own-license {
            text-align: left;
        }
        /* Desktop reaches this page through Help > About Cha, in its own
           window, so the link back to Pattern Syntax (which has its own Help
           entry and window) is redundant chrome there. The class is set only
           when the desktop shell passes `?platform=desktop`; mobile and web
           load this file with no query, keep the link, and need it — the help
           sheet's iframe navigation is their only route between the pages. */
        html.desktop .back {
            display: none;
        }
    </style>
    <!-- See desktop.rs: the desktop app opens this page with `?platform=desktop`,
         and this mirrors that onto <html> for the rule above. Backend-supplied
         truth passed through the URL, not user-agent sniffing — these pages are
         static and run no IPC. Inline and in <head> so nothing flashes before it
         is hidden. -->
    <script>
        if (new URLSearchParams(location.search).get("platform") === "desktop")
            document.documentElement.classList.add("desktop");
    </script>
</head>

